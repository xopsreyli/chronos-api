generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  nickname String @unique @db.VarChar(16)
  email    String @unique
  password String

  calendars       UserCalendar[]
  arrangements    Arrangement[]
  reminders       Reminder[]
  tasks           Task[]
  settings        Settings?
  sentInvites     CalendarInvite[] @relation("Inviter")
  receivedInvites CalendarInvite[] @relation("Invitee")
}

enum Theme {
  light
  dark
}

model Settings {
  id               Int    @id @default(autoincrement())
  userId           Int    @unique
  theme            Theme?
  arrangementColor String @default("#60a5fa")
  reminderColor    String @default("#f472b6")
  taskColor        String @default("#a78bfa")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Calendar {
  id          Int     @id @default(autoincrement())
  name        String
  description String? @db.Text
  color       String  @default("#7FFFD4")
  // isDefault   Boolean @default(false)

  users        UserCalendar[]
  arrangements Arrangement[]
  reminders    Reminder[]
  tasks        Task[]
  invites      CalendarInvite[]
}

model CalendarInvite {
  id         Int @id @default(autoincrement())
  calendarId Int
  inviterId  Int
  inviteeId  Int

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  inviter  User     @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee  User     @relation("Invitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([calendarId, inviteeId])
}

// enum Rights {
//   full
//   self
//   none
// }

model UserCalendar {
  userId     Int
  calendarId Int
  // rights     Rights
  // isActive   Boolean  @default(true)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@id([userId, calendarId])
}

enum EventType {
  arrangement
  reminder
  task
}

model Arrangement {
  id          Int       @id @default(autoincrement())
  calendarId  Int
  userId      Int
  type        EventType @default(arrangement)
  title       String
  description String    @db.Text
  from        DateTime
  to          DateTime

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Reminder {
  id          Int       @id @default(autoincrement())
  calendarId  Int
  userId      Int
  type        EventType @default(reminder)
  title       String
  description String    @db.Text
  dateTime    DateTime

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id          Int       @id @default(autoincrement())
  calendarId  Int
  userId      Int
  type        EventType @default(task)
  title       String
  description String    @db.Text
  dateTime    DateTime

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
